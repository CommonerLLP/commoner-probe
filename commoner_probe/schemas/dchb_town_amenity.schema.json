{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CommonerLLP/commoner-probe/schemas/v1/dchb_town_amenity.json",
  "title": "town_amenity_rows.jsonl — DCHB Town Release amenity row",
  "description": "One TOWN from a District Census Handbook Town Release spreadsheet, 2011 Census. `measure` is pinned to the const \"count\" because these are counts of facilities, while the rural Village Amenities equivalent is an availability FLAG per village (A=1/NA=2). Adding the two produces the widely-cited and wrong \"~75,000 public libraries\", since the rural figure counts villages that HAVE a library rather than libraries. Libraries and reading rooms are separate facilities in the source and stay separate here — there is deliberately no field combining them. Govt and private ARE both counts of the same facility, so `public_library_total` is a legitimate sum of those two only.",
  "type": "object",
  "required": [
    "key", "kind", "record_type", "source", "census_year", "measure",
    "state_code", "town_code", "town_name",
    "public_library_govt", "public_library_private", "public_library_total",
    "source_filename", "source_sha256", "extracted_at"
  ],
  "properties": {
    "key": { "type": "string", "pattern": "^DCHB\\|[^|]+\\|[^|]*\\|.+$" },
    "kind": { "const": "dchb_town_amenity" },
    "record_type": { "const": "dchb_town_amenity" },
    "source": { "type": "string" },
    "census_year": { "type": "string" },
    "measure": { "const": "count" },
    "state_code": { "type": ["string", "null"] },
    "state_name": { "type": ["string", "null"] },
    "district_code": { "type": ["string", "null"] },
    "district_name": { "type": ["string", "null"] },
    "subdistrict_code": { "type": ["string", "null"] },
    "subdistrict_name": { "type": ["string", "null"] },
    "town_code": { "type": ["string", "null"] },
    "town_name": { "type": ["string", "null"] },
    "total_households": { "type": ["integer", "null"], "minimum": 0 },
    "total_population": { "type": ["integer", "null"], "minimum": 0 },
    "public_library_govt": { "type": ["integer", "null"], "minimum": 0 },
    "public_library_private": { "type": ["integer", "null"], "minimum": 0 },
    "public_library_total": { "type": "integer", "minimum": 0 },
    "public_library_govt_status": { "enum": ["available", "not_available", null] },
    "public_library_private_status": { "enum": ["available", "not_available", null] },
    "reading_room_govt": { "type": ["integer", "null"], "minimum": 0 },
    "reading_room_private": { "type": ["integer", "null"], "minimum": 0 },
    "reading_room_total": { "type": "integer", "minimum": 0 },
    "reading_room_govt_status": { "enum": ["available", "not_available", null] },
    "reading_room_private_status": { "enum": ["available", "not_available", null] },
    "source_filename": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extracted_at": { "type": "string" }
  }
}
