{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CommonerLLP/commoner-probe/schemas/v1/manifest_nada_study.json",
  "title": "manifest.jsonl — NADA study",
  "description": "One study in a NADA (National Data Archive) instance — a survey round, a census table series, and so on. `resources_status` separates 'the related-materials page failed' from 'this study has no documents': a failed page reported as zero documents is a silent success. `sampling_procedure_chars` is a presence signal for the written sample design; the prose itself lives in the stored DDI payload at `metadata_path`. Volatile source counters (total_views, total_downloads) are deliberately not recorded — they churn on every re-fetch and tell a consumer nothing about the artefact.",
  "type": "object",
  "required": [
    "key",
    "kind",
    "record_type",
    "source",
    "base_url",
    "idno",
    "catalog_id",
    "title",
    "metadata_path",
    "metadata_sha256",
    "sampling_procedure_chars",
    "resources_status",
    "resources_found",
    "checked_at"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^NADA\\|[^|]+\\|.+$"
    },
    "kind": { "const": "nada_study" },
    "record_type": { "const": "nada_study" },
    "source": { "type": "string" },
    "base_url": { "type": "string" },
    "idno": { "type": "string", "minLength": 1 },
    "catalog_id": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": ["string", "null"] },
    "collection": { "type": ["string", "null"] },
    "authoring_entity": { "type": ["string", "null"] },
    "nation": { "type": ["string", "null"] },
    "year_start": { "type": ["string", "null"] },
    "year_end": { "type": ["string", "null"] },
    "study_type": { "type": ["string", "null"] },
    "metadata_path": { "type": "string" },
    "metadata_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sampling_procedure_chars": { "type": "integer", "minimum": 0 },
    "resources_status": { "enum": ["ok", "unavailable"] },
    "resources_found": { "type": "integer", "minimum": 0 },
    "variables_path": { "type": ["string", "null"] },
    "variables_count": { "type": ["integer", "null"] },
    "data_files_path": { "type": ["string", "null"] },
    "data_files_count": { "type": ["integer", "null"] },
    "checked_at": { "type": "string" },
    "fetched_at": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  }
}
