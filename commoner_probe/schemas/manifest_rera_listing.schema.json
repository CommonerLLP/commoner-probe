{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CommonerLLP/commoner-probe/schemas/v1/manifest_rera_listing.json",
  "title": "manifest.jsonl — RERA listing capture",
  "description": "One request to a state RERA portal's project listing, with the form values sent and the stored response. The rows parsed from the response live in rera_project_rows.jsonl. `status` is `downloaded` or `error`; on `error` the response fields that the request never produced (`http_status`, `path`, `sha256`, `bytes`, `row_count`) are null and `error` says why.",
  "type": "object",
  "required": [
    "key", "kind", "state", "url", "method", "form", "http_status", "path",
    "sha256", "bytes", "row_count", "fetched_at", "status", "error"
  ],
  "properties": {
    "key": { "type": "string", "pattern": "^RERA\\|IN-[A-Z0-9]{2,3}\\|.+$" },
    "kind": { "const": "rera_listing" },
    "record_type": { "const": "rera_listing" },
    "source": { "type": "string" },
    "state": { "type": "string", "pattern": "^IN-[A-Z0-9]{2,3}$" },
    "url": { "type": "string" },
    "method": { "type": "string" },
    "form": { "type": "object" },
    "http_status": { "type": ["integer", "null"] },
    "path": { "type": ["string", "null"] },
    "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "bytes": { "type": ["integer", "null"], "minimum": 0 },
    "row_count": { "type": ["integer", "null"], "minimum": 0 },
    "fetched_at": { "type": "string" },
    "status": { "enum": ["downloaded", "error"] },
    "error": { "type": ["string", "null"] }
  }
}
